DATABASE_URL=sqlite:///./credit_scoring.db
# Example placeholder only. From backend/, run python -m app.init_secrets
# to generate a local JWT secret in .env; keep that file outside Git.
JWT_SECRET=dev-only-change-me
# Token lifetime in minutes (480 = 8 hours).
JWT_EXPIRE_MINUTES=480
# BR7: leave empty. `python -m app.init_secrets` fills it once and never
# overwrites it. Losing this key makes stored identifiers unreadable.
DATA_ENCRYPTION_KEY=
