DATABASE_URL=sqlite:///./credit_scoring.db
# Example placeholder only. From backend/, run python -m app.init_secrets
# to generate a local JWT secret in .env; keep that file outside Git.
JWT_SECRET=dev-only-change-me
# Token lifetime in minutes (480 = 8 hours).
JWT_EXPIRE_MINUTES=480
# BR7: leave empty. `python -m app.init_secrets` fills it once and never
# overwrites it. Losing this key makes stored identifiers unreadable.
DATA_ENCRYPTION_KEY=

# Development keeps the local SQLite default. Set production values on hosting.
APP_ENV=development
# Opt-in synthetic demo seed on startup, only when the database has no loans.
# Existing records/accounts/passwords are never reset.
SEED_DEMO=false
# For hosted production set DATABASE_URL in platform settings to PostgreSQL,
# with sslmode=require. postgres:// and postgresql:// use the psycopg 3 driver.
# Keep JWT_SECRET (at least 32 characters) and DATA_ENCRYPTION_KEY stable.
# Backup only: supply BACKUP_ENCRYPTION_KEY through the command environment.
# Keep it separate from the encrypted archive; do not store any key in Git.
